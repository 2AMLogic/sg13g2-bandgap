{
  "_comment": [
    "sg13g2-bandgap -- `klt sim` request template for closed-loop-zout-pex",
    "(issue #278). Same per-(process, supply) instantiation and the same",
    "seeded-op AC shape as the psrr bench; the injection is Itest (1 A AC",
    "at vref, DC 0) and the dB sign is +, so Zout = db(v(vref)). See the",
    "body template's header and sim/harness/enrich_ac_report.py."
  ],
  "engine": "ngspice",
  "netlist": "@@BODY@@",
  "netlist_source": "extracted",
  "models": {
    "lib": "@@CORNER_BUNDLE@@"
  },
  "corners": {
    "process": [
      "typ",
      "bcs",
      "wcs",
      "sf",
      "fs"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 30 1 1e9"
  },
  "measurements": [
    {
      "name": "zout_dc_lin",
      "spice": ".meas ac zout_dc_lin find v(vref) at=1"
    },
    {
      "name": "zout_1khz_lin",
      "spice": ".meas ac zout_1khz_lin find v(vref) at=1k"
    },
    {
      "name": "zout_100khz_lin",
      "spice": ".meas ac zout_100khz_lin find v(vref) at=100k"
    },
    {
      "name": "zout_1mhz_lin",
      "spice": ".meas ac zout_1mhz_lin find v(vref) at=1meg"
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true
  }
}
