# Sanity anchors for the p12-w2 variant body (issue #631).
#
# Same role as the as-built anchors hardcoded in run_klt_sim.sh: the local
# typ/27C/3.30V sanity corner of THIS body must land within these bands
# before any grid is dispatched, so a rerun proves it simulated the same
# DUT. The values are this variant's OWN typ/27C/3.30V operating point --
# measured with sim/closed-loop-psrr/attribution/run_probe.sh typ 27 3.30
# p12-w2 (single local corner, seeds from sim/closed-loop-startup's newest
# committed record, same body construction the runner instantiates):
#
#   psrr_dc_db = 67.02288    vref_op_v = 1.047754
#
# (as-built anchors for contrast: 66.0695 dB / 1.047278 V -- the variant
# shifts the typ point by +0.95 dB and +0.48 mV.)
ANCHOR_DB="67.0229"
ANCHOR_DB_TOL="0.1"
ANCHOR_VREF_OP_V="1.047754"
ANCHOR_VREF_TOL_V="0.002"
