v {xschem version=3.4.8RC file_version=1.3
* bandgap_amp symbol -- error amplifier (issue #58). Pins match
* design/bandgap_amp.sch's iopin list exactly: vdd, vss, in_p, in_n, out.
* in_p is the non-inverting input (wire to bandgap_core's sns2), in_n the
* inverting input (wire to sns1) -- see bandgap_amp.sch's own header
* "polarity" section for the derivation; getting this backwards at the
* design/bandgap_top.sch instantiation site turns the loop positive
* feedback.
}
G {}
K {type=subcircuit
format="@spiceprefix@name @pinlist bandgap_amp"
template="name=x1
spiceprefix=X"
}
V {}
S {}
E {}
L 4 -30 -50 30 -50 {}
L 4 -30 50 30 50 {}
L 4 -30 -50 -30 50 {}
L 4 30 -50 30 50 {}
B 5 -32 22 -28 26 {name=in_p dir=inout pinnumber=1}
B 5 -32 -6 -28 -2 {name=in_n dir=inout pinnumber=2}
B 5 -32 -32 -28 -28 {name=vss dir=inout pinnumber=3}
B 5 28 12 32 16 {name=out dir=inout pinnumber=4}
B 5 28 -32 32 -28 {name=vdd dir=inout pinnumber=5}
T {in_p} -25 24 0 1 0.2 0.2 {}
T {in_n} -25 -4 0 1 0.2 0.2 {}
T {vss} -25 -30 0 1 0.2 0.2 {}
T {out} 25 14 0 0 0.2 0.2 {}
T {vdd} 25 -30 0 0 0.2 0.2 {}
T {@name} -28 55 0 0 0.2 0.2 {}
T {bandgap_amp} -20 0 0 0 0.2 0.2 {}
