v {xschem version=3.4.8RC file_version=1.3
* bandgap_core symbol (SG13CMOS5L) -- grounded-collector pnpMPA
* diode-referenced core (issue #64). Generated for issue #68's
* design/sg13cmos5l/bandgap_top.sch instantiation (issue #64 landed the
* schematic without a symbol -- no top-level wiring existed yet to need
* one), mirroring ../bandgap_core.sym's (SG13G2, issue #58) role. Pins
* match design/sg13cmos5l/bandgap_core.sch's iopin list exactly: vdd, vss,
* fb, sns1, sns2, vref.
}
G {}
K {type=subcircuit
format="@spiceprefix@name @pinlist bandgap_core"
template="name=x1
spiceprefix=X"
}
V {}
S {}
E {}
L 4 -40 -70 40 -70 {}
L 4 -40 70 40 70 {}
L 4 -40 -70 -40 70 {}
L 4 40 -70 40 70 {}
B 5 -42 46 -38 50 {name=vdd dir=inout pinnumber=1}
B 5 -42 -50 -38 -46 {name=vss dir=inout pinnumber=2}
B 5 38 46 42 50 {name=fb dir=inout pinnumber=3}
B 5 -42 14 -38 18 {name=sns1 dir=inout pinnumber=4}
B 5 -42 -18 -38 -14 {name=sns2 dir=inout pinnumber=5}
B 5 38 -18 42 -14 {name=vref dir=inout pinnumber=6}
T {vdd} -35 48 0 1 0.2 0.2 {}
T {vss} -35 -48 0 1 0.2 0.2 {}
T {fb} 35 48 0 0 0.2 0.2 {}
T {sns1} -35 16 0 1 0.2 0.2 {}
T {sns2} -35 -16 0 1 0.2 0.2 {}
T {vref} 35 -16 0 0 0.2 0.2 {}
