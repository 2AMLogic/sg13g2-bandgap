v {xschem version=3.4.8RC file_version=1.3
* bandgap_startup symbol (SG13CMOS5L) -- current-sensing, self-disabling
* startup kick for the pnpMPA-based core (issue #68). Generated for this
* same issue's design/sg13cmos5l/bandgap_top.sch instantiation. Pins
* match design/sg13cmos5l/bandgap_startup.sch's iopin list exactly: vdd,
* vss, sns1, fb.
}
G {}
K {type=subcircuit
format="@spiceprefix@name @pinlist bandgap_startup"
template="name=x1
spiceprefix=X"
}
V {}
S {}
E {}
L 4 -30 -50 30 -50 {}
L 4 -30 50 30 50 {}
L 4 -30 -50 -30 50 {}
L 4 30 -50 30 50 {}
B 5 -32 22 -28 26 {name=vdd dir=inout pinnumber=1}
B 5 -32 -28 -28 -24 {name=vss dir=inout pinnumber=2}
B 5 -32 -2 -28 2 {name=sns1 dir=inout pinnumber=3}
B 5 28 -2 32 2 {name=fb dir=inout pinnumber=4}
T {vdd} -25 24 0 1 0.2 0.2 {}
T {vss} -25 -26 0 1 0.2 0.2 {}
T {sns1} -25 0 0 1 0.2 0.2 {}
T {fb} 25 0 0 0 0.2 0.2 {}
T {@name} -28 55 0 0 0.2 0.2 {}
T {bandgap_startup} -25 -20 0 0 0.15 0.15 {}
