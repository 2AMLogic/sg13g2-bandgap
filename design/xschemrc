#### Project-local xschem configuration for sg13g2-bandgap (issue #9).
####
#### Modeled on gf180-bandgap's design/xschemrc (same fleet convention): reset
#### XSCHEM_LIBRARY_PATH to a known-good baseline first, since a leftover
#### per-machine ~/.xschem/xschemrc can otherwise silently override it with
#### stale content -- see that repo's xschemrc for the incident this guards
#### against. Load this explicitly and unambiguously with:
####   xschem --rcfile design/xschemrc ...
#### (cwd-relative "./xschemrc" auto-discovery only fires if xschem's cwd
#### happens to be this directory.)

set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices

#### PDK_ROOT / PDK: pass through from the shell environment. This repo's
#### PDK variant directory is always named "ihp-sg13g2" (IHP-Open-PDK's own
#### layout, klayout-tools klt pdk find/list convention -- see
#### docs/environment-setup.md once it exists, or klt's own docs for now).

if {[info exists env(PDK_ROOT)]} {
  set PDK_ROOT $env(PDK_ROOT)
}
if {[info exists env(PDK)]} {
  set PDK $env(PDK)
} else {
  set PDK ihp-sg13g2
}

#### ---------------------------------------------------------------------
#### SG13G2 PDK resolution + this repo's libraries.
####
#### Resolves the PDK the same way `klt pdk find` does (PDK_ROOT+PDK env,
#### falling back to the usual open_pdks install prefixes) so xschem and any
#### future harness script agree on which PDK install is in use. Nothing
#### here hardcodes a machine-specific path.

if { ![info exists PDK_ROOT] || $PDK_ROOT eq {} } {
    foreach candidate [list /usr/share/pdk /usr/local/share/pdk \
                            [file join $env(HOME) share pdk] \
                            [file join $env(HOME) .ciel] \
                            [file join $env(HOME) .volare]] {
        if { [file isdir [file join $candidate $PDK libs.tech xschem]] } {
            set PDK_ROOT $candidate
            break
        }
    }
}

if { ![info exists PDK_ROOT] || $PDK_ROOT eq {} } {
    puts stderr "xschemrc: no $PDK install found under PDK_ROOT or the usual prefixes."
    puts stderr "xschemrc: set PDK_ROOT (and optionally PDK) and restart xschem -- see"
    puts stderr "xschemrc: scripts/fetch-ihp-sg13g2.sh in klayout-tools, or klt pdk find."
} else {
    set env(PDK_ROOT) $PDK_ROOT
    set env(PDK) $PDK
    set pdk_xschemrc [file join $PDK_ROOT $PDK libs.tech xschem xschemrc]
    if { [file exists $pdk_xschemrc] } {
        source $pdk_xschemrc
    } else {
        puts stderr "xschemrc: $pdk_xschemrc not found; $PDK symbols unavailable."
    }
}

#### ------------------------------------------------------- repo libraries ---
#### Re-assert the generic devices library and add this repo's directories
#### last, so that sourcing the PDK's xschemrc above cannot drop them.
set REPO_ROOT [file dirname [file dirname [file normalize [info script]]]]

if { ![info exists XSCHEM_LIBRARY_PATH] } { set XSCHEM_LIBRARY_PATH {} }
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices

# Search the invoking schematic's own directory FIRST, ahead of the flat
# design/ directory below. Needed since issue #68: design/sg13cmos5l/ (and
# any future design/<pdk-variant>/ dir, issue #64's own placement decision)
# holds schematics with the SAME base filenames as design/'s own SG13G2
# originals (bandgap_core.sch, bandgap_amp.sch, ...) -- without this entry
# searched first, a hierarchical instantiation from within
# design/sg13cmos5l/ (e.g. bandgap_top.sch placing "bandgap_core.sym")
# silently resolves to design/bandgap_core.sym/.sch instead (both on the
# path, same base name), producing a netlist built from the WRONG PDK's
# devices with no error -- confirmed by reproducing exactly this failure
# while porting bandgap_top.sch for issue #68 (SG13G2's npn13G2 turning up
# in what should be an all-pnpMPA SG13CMOS5L netlist). [pwd] matches this
# repo's own documented invocation convention for both PDK variants
# (`cd design && xschem ...` for SG13G2, `cd design/sg13cmos5l && xschem
# ...` for SG13CMOS5L -- see design/README.md and
# design/sg13cmos5l/README.md's own "Running xschem" sections) so it
# resolves to the correct per-invocation directory without hardcoding any
# PDK-variant name here.
append XSCHEM_LIBRARY_PATH :[pwd]
append XSCHEM_LIBRARY_PATH :[file join $REPO_ROOT design]
append XSCHEM_LIBRARY_PATH :[file join $REPO_ROOT design symbols]

# Testbenches live at sim/<experiment-slug>/testbench/ (fleet convention,
# see gf180-bandgap/sim/README.md) -- glob is a no-op until sim/ has any.
foreach tb_dir [glob -nocomplain -type d [file join $REPO_ROOT sim * testbench]] {
    append XSCHEM_LIBRARY_PATH :$tb_dir
}

# Netlists land next to the schematics they came from, not in a scratch dir,
# so the ngspice fragment a future testbench includes is reviewable in git.
set netlist_dir [file join $REPO_ROOT design netlist]
file mkdir $netlist_dir

# Start on an empty sheet rather than the PDK's demo top-level.
set XSCHEM_START_WINDOW {}
