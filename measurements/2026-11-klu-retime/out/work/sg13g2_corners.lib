.lib "/opt/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib" mos_fs
.lib "/opt/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib" res_typ
.endl fs

